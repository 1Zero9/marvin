generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id           String       @id @default(cuid())
  isbn         String?      @unique
  title        String
  author       String?
  coverUrl     String?
  pageCount    Int?
  favourite    Boolean      @default(false)
  archived     Boolean      @default(false)
  householdId  String
  household    Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?        @relation("BookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  visibility   String       @default("private")
  createdAt    DateTime     @default(now())
  indexEntries IndexEntry[]
  recipes      Recipe[]

  @@index([householdId])
  @@index([householdId, visibility])
}

model IndexEntry {
  id         String @id @default(cuid())
  bookId     String
  book       Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  ingredient String
  dish       String
  page       Int

  @@index([ingredient])
  @@index([dish])
}

model Recipe {
  id              String                 @id @default(cuid())
  title           String
  source          String
  bookId          String?
  book            Book?                  @relation(fields: [bookId], references: [id], onDelete: SetNull)
  pageRef         Int?
  ingredients     String?
  instructions    String?
  notes           String?
  tags            String[]
  keywords        String[]
  links           String[]
  instagramUrl    String?
  shareSlug       String?                @unique
  shareEnabled    Boolean                @default(false)
  householdId     String
  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?                  @relation("RecipeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  visibility      String                 @default("private")
  archived        Boolean                @default(false)
  photos          Photo[]
  cookLogs        CookLog[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  mealPlanEntries MealPlanEntry[]
  swapSuggestions RecipeSwapSuggestion[]
  variants        RecipeVariant[]

  @@index([householdId])
  @@index([householdId, visibility])
}

model CookLog {
  id         String       @id @default(cuid())
  recipeId   String
  recipe     Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  cookedAt   DateTime     @default(now())
  countsAsCooked Boolean  @default(true)
  rating     Int?
  notes      String?
  context    String       @default("home")
  venue      String?
  tags       String[]     @default([])
  photos     Photo[]
  shareSlug  String?      @unique
  cookedById String?
  cookedBy   User?        @relation("CookedBy", fields: [cookedById], references: [id], onDelete: SetNull)
  ratings    MealRating[]

  @@index([context])
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id])
  cookLogId String?
  cookLog   CookLog? @relation(fields: [cookLogId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  displayName           String
  passwordHash          String
  aiProcessingEnabled   Boolean                @default(true)
  foodExclusions        String[]               @default([])
  showDailyCompanion    Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           Membership[]
  sessions              Session[]
  cookedLogs            CookLog[]              @relation("CookedBy")
  mealRatings           MealRating[]
  invitesSent           Invite[]               @relation("InvitedBy")
  createdBooks          Book[]                 @relation("BookCreatedBy")
  createdRecipes        Recipe[]               @relation("RecipeCreatedBy")
  weightLogs            WeightLog[]
  goal                  UserGoal?
  alcoholLogs           AlcoholLog[]
  alcoholPhases         AlcoholPhase[]
  workoutSessions       WorkoutSession[]
  dailyChecklists       DailyChecklist[]
  checklistSettings     ChecklistSettings?
  dailyRatings          DailyRating[]
  dailyCompanions       DailyCompanion[]
  weeklyReflections     WeeklyReflection[]
  mealPlanEntries       MealPlanEntry[]
  shoppingListItems     ShoppingListItem[]
  recipeSwapSuggestions RecipeSwapSuggestion[]
  recipeVariants        RecipeVariant[]
  recoveryCodes         AccountRecoveryCode[]
  passwordResetTokens   PasswordResetToken[]
}

// A user-held recovery code. The raw value is shown exactly once and only a
// hash is kept, so Marvin can support password recovery without a mail provider.
model AccountRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId, usedAt])
}

// A short-lived, one-time password reset token. Only its hash is persisted.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Household {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  invites     Invite[]
  books       Book[]
  recipes     Recipe[]
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  householdId String
  role        String    @default("member")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id          String    @id @default(cuid())
  householdId String
  invitedById String
  email       String?
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([householdId])
}

model MealRating {
  id        String   @id @default(cuid())
  cookLogId String
  userId    String
  rating    Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cookLog   CookLog  @relation(fields: [cookLogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cookLogId, userId])
  @@index([userId])
}

// --- Health module (personal, scoped to userId — not shared across household) ---

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Float
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model UserGoal {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetWeightKg Float
  heightCm       Float
  updatedAt      DateTime @updatedAt
}

model AlcoholLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  hadDrink  Boolean
  units     Float?
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model AlcoholPhase {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String // "zero" | "moderate"
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date // null = ongoing (moderate phases have no fixed end)
  weeklyUnitTarget Int? // only relevant when type = "moderate"
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([userId, active])
}

model Exercise {
  id                String  @id @default(cuid())
  name              String
  category          String // strength | core | mobility | low-impact-cardio | chest | ankle-rehab | back-rehab
  cue               String // one-line plain instruction
  whySafeNote       String? // why this is ankle/back-friendly
  beginnerVariant   String?
  progressedVariant String?
  iconUrl           String? // custom line-art, not sourced from external db
  physioPrescribed  Boolean @default(false)
  reps              String? // e.g. "10", "8-10", "12"
  sets              Int?
  holdSeconds       Int?
  frequencyPerDay   Int? // e.g. 3 = "3 times daily"
  source            String? // e.g. "Tyrrell Physiotherapy, Gerard Tyrrell"
  sortOrder         Int     @default(0)
}

model WorkoutSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  durationMin Int
  exerciseIds String[] // Exercise ids completed
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model DailyChecklist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  items     Json // e.g. [{label: "No alcohol", done: true}, ...]
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model ChecklistSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  labels    String[] // the 3-4 user-chosen non-negotiables
  updatedAt DateTime @updatedAt
}

model DailyRating {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  stuckToPlan String? // "yes" | "partial" | "no"
  energyMood  Int? // 1-5 scale
  note        String?
  createdAt   DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// A private daily check-in. This never belongs to a household or a shareable record.
model DailyCompanion {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  intention    String?
  waterGlasses Int      @default(0)
  reflection   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// A private weekly review and one self-chosen experiment. It is never shared.
model WeeklyReflection {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart  DateTime @db.Date
  win        String?
  lesson     String?
  experiment String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

// --- Health module, pass 2 (schema stable now, UI built later) ---

model MealPlanEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  mealType     String // "breakfast" | "lunch" — a personal plan, never household-visible
  recipeId     String?
  recipe       Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  freeformText String? // quick entry, if not using an indexed recipe
  createdAt    DateTime @default(now())

  @@unique([userId, date, mealType])
  @@index([userId, date])
}

model ShoppingListItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate DateTime @db.Date
  ingredient    String
  quantity      String? // kept as string, e.g. "2" or "1 tin" — aggregation is best-effort text merge
  checked       Boolean  @default(false)
  source        String   @default("auto") // "auto" (from planned meals) | "manual"
  createdAt     DateTime @default(now())

  @@index([userId, weekStartDate])
}

model RecipeSwapSuggestion {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  suggestions Json // [{original, swap, reason, impactLevel}]
  generatedAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@index([userId])
  @@index([recipeId])
}

model RecipeVariant {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalRecipeId String
  originalRecipe   Recipe   @relation(fields: [originalRecipeId], references: [id], onDelete: Cascade)
  name             String // e.g. "Lightened version"
  ingredients      Json
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([userId, originalRecipeId])
  @@index([userId])
  @@index([originalRecipeId])
}
