{
  "name": "marvin",
  "version": "0.31.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:env && prisma generate && prisma migrate deploy && next build",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "npm run test && npm run typecheck",
    "start": "npm run validate:env && next start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "prisma generate && tsc --noEmit",
    "validate:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/validate-runtime-env.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "@zxing/library": "^0.21.3",
    "mammoth": "^1.12.0",
    "next": "^15.5.20",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.61.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "6.28.0"
  }
}
