# Public canonical origin used in invitation and password-reset links.
APP_URL=https://marvin.example.com

# Pooled runtime Postgres connection. Use a direct connection only for migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Private Vercel Blob store used for cookbook covers and meal photos.
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Optional AI features. Users can disable AI processing in privacy controls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Weighted AI operations allowed per user. Image batches consume one unit per image.
AI_HOURLY_UNIT_LIMIT=20
AI_DAILY_UNIT_LIMIT=60

# Optional email-based password recovery.
RESEND_API_KEY=
EMAIL_FROM=Marvin <marvin@example.com>
